// ==========================================
// 表紙スライド作成
// ==========================================

/**
 * 表紙スライドを作成
 * @param {Presentation} プレゼン - プレゼンテーションオブジェクト
 * @param {Object} クライアントデータ - クライアント情報
 */
function 表紙スライドを作成(プレゼン, クライアントデータ) {
  const スライド = プレゼン.appendSlide(SlidesApp.PredefinedLayout.BLANK);
  背景色を設定(スライド);

  // タイトル
  テキストボックスを追加(
    スライド,
    'CAMPFIRE',
    余白.左,
    100,
    コンテンツ幅,
    60,
    {
      フォントサイズ: 42,
      太字: true,
      文字色: 色設定.見出し帯,
      中央揃え: true
    }
  );

  // サブタイトル
  テキストボックスを追加(
    スライド,
    '出版プロジェクト\nマーケティング戦略資料',
    余白.左,
    180,
    コンテンツ幅,
    80,
    {
      フォントサイズ: 28,
      太字: true,
      文字色: 色設定.本文色,
      中央揃え: true
    }
  );

  // プロジェクト情報カード
  const カード高さ = 180;
  const カードTop = 320;

  カードボックスを追加(スライド, 余白.左, カードTop, コンテンツ幅, カード高さ);

  // 起案者名
  テキストボックスを追加(
    スライド,
    `👤 起案者`,
    余白.左 + 20,
    カードTop + 20,
    コンテンツ幅 - 40,
    30,
    {
      フォントサイズ: 14,
      文字色: 色設定.テキスト薄
    }
  );

  テキストボックスを追加(
    スライド,
    クライアントデータ.起案者名,
    余白.左 + 20,
    カードTop + 50,
    コンテンツ幅 - 40,
    35,
    {
      フォントサイズ: 22,
      太字: true,
      文字色: 色設定.本文色
    }
  );

  // 目標金額
  テキストボックスを追加(
    スライド,
    `💰 目標金額`,
    余白.左 + 20,
    カードTop + 100,
    コンテンツ幅 - 40,
    25,
    {
      フォントサイズ: 14,
      文字色: 色設定.テキスト薄
    }
  );

  const 金額表示 = Number(クライアントデータ.目標金額).toLocaleString() + '円';
  テキストボックスを追加(
    スライド,
    金額表示,
    余白.左 + 20,
    カードTop + 125,
    コンテンツ幅 - 40,
    30,
    {
      フォントサイズ: 24,
      太字: true,
      文字色: 色設定.見出し帯
    }
  );

  // フッター
  テキストボックスを追加(
    スライド,
    '2026.01〜',
    余白.左,
    ページサイズ.高さ - 余白.下 - 20,
    コンテンツ幅,
    20,
    {
      フォントサイズ: 11,
      文字色: 色設定.テキスト薄,
      中央揃え: true
    }
  );

  Logger.log('✅ 表紙スライド作成完了');
}

// ==========================================
// 目次スライド作成
// ==========================================

/**
 * 目次スライドを作成
 */
function 目次スライドを作成(プレゼン) {
  const スライド = プレゼン.appendSlide(SlidesApp.PredefinedLayout.BLANK);
  背景色を設定(スライド);

  見出し帯を追加(スライド, 'INDEX 目次');

  const 章リスト = [
    '01. 導入・プロジェクト概要',
    '02. 成功の実態データ',
    '03. 準備フェーズ「まずは100人」',
    '04. 初動3日間「スタートダッシュ」',
    '05. SNS・発信戦略',
    '06. まとめ・次の一手'
  ];

  let currentTop = 余白.上 + 70;

  章リスト.forEach((章, index) => {
    // 章番号の円
    const 円 = スライド.insertShape(
      SlidesApp.ShapeType.ELLIPSE,
      余白.左 + 10,
      currentTop + 5,
      25,
      25
    );

    円.getFill().setSolidFill(色設定.アクセント);
    円.getBorder().setTransparent();

    const 円テキスト = 円.getText();
    円テキスト.setText(String(index + 1).padStart(2, '0'));
    円テキスト.getTextStyle()
      .setFontSize(12)
      .setBold(true)
      .setForegroundColor('#FFFFFF');

    円テキスト.getParagraphStyle()
      .setParagraphAlignment(SlidesApp.ParagraphAlignment.CENTER);

    円.setContentAlignment(SlidesApp.ContentAlignment.MIDDLE);

    // 章タイトル
    テキストボックスを追加(
      スライド,
      章,
      余白.左 + 50,
      currentTop,
      コンテンツ幅 - 60,
      35,
      {
        フォントサイズ: 16,
        文字色: 色設定.本文色
      }
    );

    currentTop += 60;
  });

  Logger.log('✅ 目次スライド作成完了');
}

