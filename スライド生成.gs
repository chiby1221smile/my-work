// ==========================================
// CAMPFIRE成功法則の定義（プロンプトに注入）
// ==========================================

const CAMPFIRE成功法則 = `
【絶対ルール】
- 専門用語は一切禁止：KPI→「数値目標」、リーチ→「見た人の数」、エンゲージメント→「仲間の熱量」など、中学生でもわかる日本語に翻訳すること
- 成功の数値目標：初日15%・3日間30%達成が必須、初日に30%達成すると成功率90%以上
- 支援者の実態：支援者の8割は身近な人（知人・友人・家族・仕事関係者）
- お気に入り登録：公開前にお気に入り100件必須、登録者の約40%が支援に転換
- アクション：連絡先リスト300名作成、1対1の個別メッセージ（コピペ厳禁）の徹底
`;

// ==========================================
// 表紙スライド作成
// ==========================================

/**
 * 表紙スライドを作成
 * @param {Presentation} プレゼン - プレゼンテーションオブジェクト
 * @param {Object} クライアントデータ - クライアント情報
 */
function 表紙スライドを作成(プレゼン, クライアントデータ) {
  const スライド = プレゼン.appendSlide(SlidesApp.PredefinedLayout.BLANK);
  背景色を設定(スライド);

  // タイトル
  テキストボックスを追加(
    スライド,
    'CAMPFIRE',
    余白.左,
    100,
    コンテンツ幅,
    60,
    {
      フォントサイズ: 42,
      太字: true,
      文字色: 色設定.見出し帯,
      中央揃え: true
    }
  );

  // サブタイトル
  テキストボックスを追加(
    スライド,
    '出版プロジェクト\nマーケティング戦略資料',
    余白.左,
    180,
    コンテンツ幅,
    80,
    {
      フォントサイズ: 28,
      太字: true,
      文字色: 色設定.本文色,
      中央揃え: true
    }
  );

  // プロジェクト情報カード
  const カード高さ = 180;
  const カードTop = 320;

  カードボックスを追加(スライド, 余白.左, カードTop, コンテンツ幅, カード高さ);

  // 起案者名
  テキストボックスを追加(
    スライド,
    `👤 起案者`,
    余白.左 + 20,
    カードTop + 20,
    コンテンツ幅 - 40,
    30,
    {
      フォントサイズ: 14,
      文字色: 色設定.テキスト薄
    }
  );

  テキストボックスを追加(
    スライド,
    クライアントデータ.起案者名,
    余白.左 + 20,
    カードTop + 50,
    コンテンツ幅 - 40,
    35,
    {
      フォントサイズ: 22,
      太字: true,
      文字色: 色設定.本文色
    }
  );

  // 目標金額
  テキストボックスを追加(
    スライド,
    `💰 目標金額`,
    余白.左 + 20,
    カードTop + 100,
    コンテンツ幅 - 40,
    25,
    {
      フォントサイズ: 14,
      文字色: 色設定.テキスト薄
    }
  );

  const 金額表示 = Number(クライアントデータ.目標金額).toLocaleString() + '円';
  テキストボックスを追加(
    スライド,
    金額表示,
    余白.左 + 20,
    カードTop + 125,
    コンテンツ幅 - 40,
    30,
    {
      フォントサイズ: 24,
      太字: true,
      文字色: 色設定.見出し帯
    }
  );

  // フッター
  テキストボックスを追加(
    スライド,
    '2026.01〜',
    余白.左,
    ページサイズ.高さ - 余白.下 - 20,
    コンテンツ幅,
    20,
    {
      フォントサイズ: 11,
      文字色: 色設定.テキスト薄,
      中央揃え: true
    }
  );

  Logger.log('✅ 表紙スライド作成完了');
}

// ==========================================
// 目次スライド作成
// ==========================================

/**
 * 目次スライドを作成
 */
function 目次スライドを作成(プレゼン) {
  const スライド = プレゼン.appendSlide(SlidesApp.PredefinedLayout.BLANK);
  背景色を設定(スライド);

  見出し帯を追加(スライド, 'INDEX 目次');

  const 章リスト = [
    '01. 導入・プロジェクト概要',
    '02. 成功の実態データ',
    '03. 準備フェーズ「まずは100人」',
    '04. 初動3日間「スタートダッシュ」',
    '05. SNS・発信戦略',
    '06. まとめ・次の一手'
  ];

  let currentTop = 余白.上 + 70;

  章リスト.forEach((章, index) => {
    // 章番号の円
    const 円 = スライド.insertShape(
      SlidesApp.ShapeType.ELLIPSE,
      余白.左 + 10,
      currentTop + 5,
      25,
      25
    );

    円.getFill().setSolidFill(色設定.アクセント);
    円.getBorder().setTransparent();

    const 円テキスト = 円.getText();
    円テキスト.setText(String(index + 1).padStart(2, '0'));
    円テキスト.getTextStyle()
      .setFontSize(12)
      .setBold(true)
      .setForegroundColor('#FFFFFF');

    円テキスト.getParagraphStyle()
      .setParagraphAlignment(SlidesApp.ParagraphAlignment.CENTER);

    円.setContentAlignment(SlidesApp.ContentAlignment.MIDDLE);

    // 章タイトル
    テキストボックスを追加(
      スライド,
      章,
      余白.左 + 50,
      currentTop,
      コンテンツ幅 - 60,
      35,
      {
        フォントサイズ: 16,
        文字色: 色設定.本文色
      }
    );

    currentTop += 60;
  });

  Logger.log('✅ 目次スライド作成完了');
}

// ==========================================
// Geminiで章のコンテンツを生成
// ==========================================

/**
 * 指定された章のコンテンツをGemini APIで生成
 * @param {number} 章番号 - 1〜6
 * @param {Object} クライアントデータ - クライアント情報
 * @return {Object} 生成されたコンテンツ
 */
function 章のコンテンツを生成(章番号, クライアントデータ) {
  Logger.log(`🤖 第${章番号}章のコンテンツ生成開始...`);

  const 章タイトルリスト = [
    '導入・プロジェクト概要',
    '成功の実態データ',
    '準備フェーズ「まずは100人」',
    '初動3日間「スタートダッシュ」',
    'SNS・発信戦略',
    'まとめ・次の一手'
  ];

  const 章タイトル = 章タイトルリスト[章番号 - 1];

  const プロンプト = `
あなたはCAMPFIREクラウドファンディングの専門コンサルタントです。
以下のプロジェクト情報を元に、第${章番号}章「${章タイトル}」のマーケティング戦略資料を作成してください。

【プロジェクト情報】
起案者名: ${クライアントデータ.起案者名}
目標金額: ${Number(クライアントデータ.目標金額).toLocaleString()}円
背景: ${クライアントデータ.背景}
実現したいこと: ${クライアントデータ.実現したいこと}

${CAMPFIRE成功法則}

【生成指示】
- 第${章番号}章「${章タイトル}」の内容として、10ページ分の詳細な戦略を提案してください
- 各ページには「タイトル」と「本文（箇条書き3〜5項目）」を含めてください
- 本文は具体的なアクションプランとして記述してください
- 専門用語は使わず、中学生でもわかる日本語で書いてください

【出力フォーマット】
以下のJSON形式で出力してください：

{
  "章番号": ${章番号},
  "章タイトル": "${章タイトル}",
  "ページ": [
    {
      "ページ番号": 1,
      "タイトル": "ページのタイトル",
      "本文": [
        "箇条書き項目1",
        "箇条書き項目2",
        "箇条書き項目3"
      ]
    }
  ]
}

必ず10ページ分のデータを生成してください。
`;

  try {
    const 生成結果 = Geminiでテキスト生成(プロンプト);

    // JSONを抽出（コードブロックで囲まれている場合に対応）
    let jsonテキスト = 生成結果;

    // ```json ... ``` を除去
    const jsonMatch = 生成結果.match(/```json\s*([\s\S]*?)\s*```/);
    if (jsonMatch) {
      jsonテキスト = jsonMatch[1];
    } else {
      // ``` ... ``` を除去
      const codeMatch = 生成結果.match(/```\s*([\s\S]*?)\s*```/);
      if (codeMatch) {
        jsonテキスト = codeMatch[1];
      }
    }

    const コンテンツ = JSON.parse(jsonテキスト);

    Logger.log(`✅ 第${章番号}章のコンテンツ生成完了（${コンテンツ.ページ.length}ページ）`);
    return コンテンツ;

  } catch (e) {
    Logger.log(`❌ 第${章番号}章のコンテンツ生成失敗: ${e.message}`);

    // フォールバック: サンプルデータを返す
    return {
      章番号: 章番号,
      章タイトル: 章タイトル,
      ページ: Array.from({ length: 10 }, (_, i) => ({
        ページ番号: i + 1,
        タイトル: `${章タイトル} - ページ${i + 1}`,
        本文: [
          `${クライアントデータ.プロジェクト名}のための戦略`,
          '具体的なアクションプランを記載',
          '中学生でもわかる言葉で説明'
        ]
      }))
    };
  }
}

// ==========================================
// コンテンツからスライドを生成
// ==========================================

/**
 * 生成されたコンテンツからスライドを作成
 * @param {Presentation} プレゼン - プレゼンテーションオブジェクト
 * @param {Object} コンテンツ - 章のコンテンツ
 */
function コンテンツからスライドを作成(プレゼン, コンテンツ) {
  Logger.log(`📄 第${コンテンツ.章番号}章のスライド作成開始...`);

  コンテンツ.ページ.forEach((ページ, index) => {
    const スライド = プレゼン.appendSlide(SlidesApp.PredefinedLayout.BLANK);
    背景色を設定(スライド);

    // 見出し帯
    見出し帯を追加(スライド, ページ.タイトル);

    // 本文エリア
    let currentTop = 余白.上 + 70;
    const 本文エリア高さ = コンテンツ高さ - 70 - 30; // 見出し分と下余白を引く

    // 箇条書きを追加
    ページ.本文.forEach((項目, i) => {
      // 番号付き円
      const 円 = スライド.insertShape(
        SlidesApp.ShapeType.ELLIPSE,
        余白.左 + 10,
        currentTop + 3,
        20,
        20
      );

      円.getFill().setSolidFill(色設定.アクセント);
      円.getBorder().setTransparent();

      const 円テキスト = 円.getText();
      円テキスト.setText(String(i + 1));
      円テキスト.getTextStyle()
        .setFontSize(11)
        .setBold(true)
        .setForegroundColor('#FFFFFF');

      円テキスト.getParagraphStyle()
        .setParagraphAlignment(SlidesApp.ParagraphAlignment.CENTER);

      円.setContentAlignment(SlidesApp.ContentAlignment.MIDDLE);

      // 項目テキスト（文字見切れ防止）
      const フォントサイズ = 最適フォントサイズを計算(
        項目,
        フォントサイズ.本文最大,
        フォントサイズ.本文最小,
        80
      );

      テキストボックスを追加(
        スライド,
        項目,
        余白.左 + 40,
        currentTop,
        コンテンツ幅 - 50,
        Math.min(60, 本文エリア高さ / ページ.本文.length - 10),
        {
          フォントサイズ: フォントサイズ,
          文字色: 色設定.本文色
        }
      );

      currentTop += Math.min(70, 本文エリア高さ / ページ.本文.length);
    });

    Logger.log(`  ✅ ページ${index + 1}作成完了: ${ページ.タイトル}`);
  });

  Logger.log(`✅ 第${コンテンツ.章番号}章のスライド作成完了`);
}

// ==========================================
// メイン生成関数（分割リレー形式）
// ==========================================

/**
 * 戦略資料を自動生成（Gemini版・分割リレー形式）
 */
function 戦略資料を自動生成_Gemini() {
  try {
    const ui = SpreadsheetApp.getUi();

    // APIキーチェック
    if (MY_API_KEY === "YOUR_API_KEY_HERE" || !MY_API_KEY) {
      ui.alert('❌ APIキー未設定', 'コード.gsの MY_API_KEY を設定してください。\n\nhttps://aistudio.google.com/app/apikey', ui.ButtonSet.OK);
      return;
    }

    // クライアントデータ取得
    const クライアントデータ = クライアントデータを取得();

    ui.alert('🚀 生成開始', `${クライアントデータ.プロジェクト名}の戦略資料を生成します。\n\n※60ページ生成には15〜20分かかります\n※6回に分けて生成します`, ui.ButtonSet.OK);

    // プレゼンテーション作成
    const タイトル = `CAMPFIRE戦略資料_${クライアントデータ.プロジェクト名}_${new Date().toISOString().slice(0, 10)}`;
    const プレゼン = プレゼンテーションを作成(タイトル);

    // 最初のスライドを削除
    const 初期スライド = プレゼン.getSlides()[0];
    初期スライド.remove();

    // Part 1: 表紙・目次
    表紙スライドを作成(プレゼン, クライアントデータ);
    目次スライドを作成(プレゼン);

    // Part 2-7: 各章を順番に生成（10ページ×6回）
    for (let 章番号 = 1; 章番号 <= 6; 章番号++) {
      ui.alert(`📝 Part ${章番号 + 1}/7`, `第${章番号}章を生成中...\n\nGemini APIでコンテンツを生成しています`, ui.ButtonSet.OK);

      const コンテンツ = 章のコンテンツを生成(章番号, クライアントデータ);
      コンテンツからスライドを作成(プレゼン, コンテンツ);

      ui.alert(`✅ Part ${章番号 + 1}/7 完了`, `第${章番号}章（10ページ）の生成が完了しました`, ui.ButtonSet.OK);

      // 次の章の前に少し待機（API制限対策）
      if (章番号 < 6) {
        Utilities.sleep(2000);
      }
    }

    // URLを保存
    const url = プレゼン.getUrl();
    URLを保存(url);

    // 完成通知
    ui.alert('🎉 完成！', `戦略資料の生成が完了しました！\n\n以下のURLをクリックして開いてください:\n\n${url}`, ui.ButtonSet.OK);

    Logger.log('🎉 すべての生成完了！');
    Logger.log(`URL: ${url}`);

  } catch (e) {
    Logger.log(`❌ エラー発生: ${e.message}`);
    SpreadsheetApp.getUi().alert('❌ エラー', `生成中にエラーが発生しました:\n\n${e.message}`, SpreadsheetApp.getUi().ButtonSet.OK);
  }
}
