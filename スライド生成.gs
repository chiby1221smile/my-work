/**
 * ========================================
 * スライド作成関数群（表紙・目次・第1章）
 * ========================================
 * PDF P1〜P6 準拠レイアウト（960x540 横長）
 */

// ========================================
// 表紙スライド（PDF P1準拠）
// ========================================

function 表紙スライドを作成(プレゼン, クライアントデータ, SNS情報) {
  const スライド = プレゼン.appendSlide(SlidesApp.PredefinedLayout.BLANK);
  スライド.getBackground().setSolidFill(色設定.背景色);

  // 上部中央：PROJECT STRATEGY 2026 ラベル
  const ラベル幅 = 240;
  図形を追加(スライド, '角丸長方形', {
    左位置: (ページサイズ.幅 - ラベル幅) / 2, 上位置: 25, 幅: ラベル幅, 高さ: 22,
    塗りつぶし色: '#FFFFFF'
  });
  テキストを追加(スライド, 'PROJECT STRATEGY 2026', {
    左位置: (ページサイズ.幅 - ラベル幅) / 2, 上位置: 25, 幅: ラベル幅, 高さ: 22,
    フォントサイズ: 10, 太字: true, 色: 色設定.テキスト濃, 配置: '中央'
  });

  // CAMPFIRE タイトル（超大きく、中央）
  テキストを追加(スライド, 'CAMPFIRE', {
    左位置: 余白.左, 上位置: 75, 幅: コンテンツ幅, 高さ: 60,
    フォントサイズ: 52, 太字: true, 色: 色設定.アクセント色, 配置: '中央'
  });

  // プロジェクト名 + マーケティング戦略資料
  const プロジェクト表示名 = クライアントデータ.プロジェクト名 || 'クラウドファンディング';
  テキストを追加(スライド, プロジェクト表示名, {
    左位置: 余白.左, 上位置: 145, 幅: コンテンツ幅, 高さ: 26,
    フォントサイズ: 18, 太字: true, 色: 色設定.テキスト濃, 配置: '中央'
  });
  テキストを追加(スライド, 'マーケティング戦略資料', {
    左位置: 余白.左, 上位置: 174, 幅: コンテンツ幅, 高さ: 22,
    フォントサイズ: フォントサイズ.見出し3, 色: 色設定.テキスト薄, 配置: '中央'
  });

  // アクセントライン（中央）
  図形を追加(スライド, '長方形', {
    左位置: (ページサイズ.幅 - 100) / 2, 上位置: 220, 幅: 100, 高さ: 4,
    塗りつぶし色: 色設定.アクセント色
  });

  // 中央下：起案者情報カード（オレンジ上ボーダー、角丸）
  const カードX = 240;
  const カードY = 240;
  const カード幅 = 480;
  const カード高さ = 160;

  // カード背景（角丸）
  図形を追加(スライド, '角丸長方形', {
    左位置: カードX, 上位置: カードY, 幅: カード幅, 高さ: カード高さ,
    塗りつぶし色: '#FFFFFF'
  });

  // カード上ボーダー（オレンジ）
  図形を追加(スライド, '長方形', {
    左位置: カードX, 上位置: カードY, 幅: カード幅, 高さ: 3,
    塗りつぶし色: 色設定.アクセント色
  });

  // 起案者セクション（左）
  テキストを追加(スライド, '起案者', {
    左位置: カードX + 20, 上位置: カードY + 18, 幅: 70, 高さ: 14,
    フォントサイズ: 9, 色: 色設定.テキスト薄
  });
  テキストを追加(スライド, クライアントデータ.起案者名, {
    左位置: カードX + 100, 上位置: カードY + 14, 幅: カード幅 - 140, 高さ: 22,
    フォントサイズ: フォントサイズ.見出し3, 太字: true, 色: 色設定.テキスト濃
  });

  // 区切り線1
  図形を追加(スライド, '長方形', {
    左位置: カードX + 16, 上位置: カードY + 48, 幅: カード幅 - 32, 高さ: 1,
    塗りつぶし色: 色設定.アクセント薄
  });

  // 目標金額セクション（中央）
  テキストを追加(スライド, '目標金額', {
    左位置: カードX + 20, 上位置: カードY + 62, 幅: 70, 高さ: 14,
    フォントサイズ: 9, 色: 色設定.テキスト薄
  });
  const 目標金額万 = Math.round(クライアントデータ.目標金額 / 10000);
  テキストを追加(スライド, `${目標金額万}万円`, {
    左位置: カードX + 100, 上位置: カードY + 56, 幅: カード幅 - 140, 高さ: 28,
    フォントサイズ: 20, 太字: true, 色: 色設定.アクセント色
  });

  // 区切り線2
  図形を追加(スライド, '長方形', {
    左位置: カードX + 16, 上位置: カードY + 98, 幅: カード幅 - 32, 高さ: 1,
    塗りつぶし色: 色設定.アクセント薄
  });

  // 公開期間セクション（下）
  テキストを追加(スライド, '公開期間', {
    左位置: カードX + 20, 上位置: カードY + 112, 幅: 70, 高さ: 14,
    フォントサイズ: 9, 色: 色設定.テキスト薄
  });
  テキストを追加(スライド, '2026.03.01 〜 03.31（31日間）', {
    左位置: カードX + 100, 上位置: カードY + 110, 幅: カード幅 - 140, 高さ: 20,
    フォントサイズ: フォントサイズ.本文, 色: 色設定.テキスト濃
  });

  // 左下：CAMPFIREロゴ風アイコン（簡易版）
  図形を追加(スライド, '楕円', {
    左位置: 余白.左 + 8, 上位置: 468, 幅: 36, 高さ: 36,
    塗りつぶし色: 色設定.アクセント色
  });
  // 内側の白い円
  図形を追加(スライド, '楕円', {
    左位置: 余白.左 + 15, 上位置: 475, 幅: 22, 高さ: 22,
    塗りつぶし色: '#FFFFFF'
  });

  // 下部：MEDIA CHANNELS（SNSアイコン）- もしSNS情報があれば
  if (SNS情報) {
    テキストを追加(スライド, '- MEDIA CHANNELS -', {
      左位置: 余白.左, 上位置: 454, 幅: コンテンツ幅, 高さ: 14,
      フォントサイズ: 8, 色: 色設定.テキスト薄, 配置: '中央'
    });

    const SNSリスト = [];
    if (SNS情報.Xあり) SNSリスト.push('X(Twitter)');
    if (SNS情報.Noteあり) SNSリスト.push('Note');
    if (SNS情報.Amebaあり) SNSリスト.push('Ameba');

    if (SNSリスト.length > 0) {
      const アイコン幅 = 80;
      const 全体幅 = SNSリスト.length * アイコン幅 + (SNSリスト.length - 1) * 10;
      let 開始X = (ページサイズ.幅 - 全体幅) / 2;

      SNSリスト.forEach(SNS名 => {
        図形を追加(スライド, '角丸長方形', {
          左位置: 開始X, 上位置: 475, 幅: アイコン幅, 高さ: 28,
          塗りつぶし色: '#FFFFFF'
        });
        テキストを追加(スライド, SNS名, {
          左位置: 開始X, 上位置: 483, 幅: アイコン幅, 高さ: 14,
          フォントサイズ: 8, 色: 色設定.テキスト濃, 配置: '中央'
        });
        開始X += アイコン幅 + 10;
      });
    }
  }
}

// ========================================
// 目次スライド（PDF P2準拠）
// ========================================

function 目次スライドを作成(プレゼン, SNS情報) {
  const スライド = プレゼン.appendSlide(SlidesApp.PredefinedLayout.BLANK);
  スライド.getBackground().setSolidFill(色設定.背景色);

  // 上部タイトル：INDEX 目次
  図形を追加(スライド, '長方形', {
    左位置: 余白.左, 上位置: 余白.上, 幅: コンテンツ幅, 高さ: 38,
    塗りつぶし色: '#FFFFFF'
  });
  図形を追加(スライド, '長方形', {
    左位置: 余白.左, 上位置: 余白.上, 幅: 3, 高さ: 38,
    塗りつぶし色: 色設定.アクセント色
  });
  テキストを追加(スライド, 'INDEX', {
    左位置: 余白.左 + 15, 上位置: 余白.上 + 4, 幅: 120, 高さ: 30,
    フォントサイズ: 22, 太字: true, 色: 色設定.テキスト濃
  });
  テキストを追加(スライド, '目次', {
    左位置: 余白.左 + 145, 上位置: 余白.上 + 10, 幅: 60, 高さ: 20,
    フォントサイズ: フォントサイズ.本文, 色: 色設定.テキスト薄
  });

  const 章一覧 = [
    { 番号: '01', タイトル: '導入・プロジェクト概要', ページ: 'P6' },
    { 番号: '02', タイトル: '全体スケジュール', ページ: 'P7' },
    { 番号: '03', タイトル: 'スタートダッシュ「まずは3日間」', ページ: 'P12' },
    { 番号: '04', タイトル: 'お気に入り登録100件戦略', ページ: 'P18' },
    { 番号: '05', タイトル: 'SNS・発信戦略', ページ: 'P23' },
    { 番号: '06', タイトル: 'リターン設計', ページ: 'P31' },
    { 番号: '07', タイトル: '交流会・イベント戦略', ページ: 'P36' },
    { 番号: '08', タイトル: 'プロジェクト特化戦略', ページ: 'P39' },
    { 番号: '09', タイトル: 'チェックリスト・まとめ', ページ: 'P42' }
  ];

  // 2列レイアウト
  const 列幅 = (コンテンツ幅 - 15) / 2;
  const 項目高さ = 48;
  let 列 = 0;
  let 行 = 0;

  章一覧.forEach((章, idx) => {
    const x = 列 === 0 ? 余白.左 : 余白.左 + 列幅 + 15;
    const y = 余白.上 + 52 + (行 * 項目高さ);

    // 背景カード（白、角丸）
    図形を追加(スライド, '角丸長方形', {
      左位置: x, 上位置: y, 幅: 列幅, 高さ: 42,
      塗りつぶし色: '#FFFFFF'
    });

    // 上ボーダー（オレンジ）
    図形を追加(スライド, '長方形', {
      左位置: x, 上位置: y, 幅: 列幅, 高さ: 3,
      塗りつぶし色: 色設定.アクセント色
    });

    // 章番号
    テキストを追加(スライド, 章.番号, {
      左位置: x + 10, 上位置: y + 9, 幅: 32, 高さ: 24,
      フォントサイズ: フォントサイズ.見出し3, 太字: true, 色: 色設定.アクセント色
    });

    // タイトル
    テキストを追加(スライド, 章.タイトル, {
      左位置: x + 48, 上位置: y + 7, 幅: 列幅 - 118, 高さ: 16,
      フォントサイズ: 9, 太字: true, 色: 色設定.テキスト濃
    });

    // ページ番号（右寄せ）
    テキストを追加(スライド, 章.ページ, {
      左位置: x + 列幅 - 62, 上位置: y + 9, 幅: 52, 高さ: 22,
      フォントサイズ: 11, 太字: true, 色: 色設定.アクセント色, 配置: '右'
    });

    // 次の位置を計算
    列++;
    if (列 >= 2) {
      列 = 0;
      行++;
    }
  });
}

// ========================================
// 第1章：導入・プロジェクト概要（P3-P6）
// ========================================

function 第1章を作成(プレゼン, クライアントデータ) {
  章タイトルスライドを作成(プレゼン, '01', '導入・プロジェクト概要', 'プロジェクトの成功に必要な基礎知識');
  プロジェクト概要スライドを作成(プレゼン, クライアントデータ);
  クラファン成功データスライドを作成(プレゼン);
  目標金額内訳スライドを作成(プレゼン, クライアントデータ);
  支援者見込みスライドを作成(プレゼン, クライアントデータ);
}

// ----------------------------------------
// P3: プロジェクト概要
// ----------------------------------------

function プロジェクト概要スライドを作成(プレゼン, クライアントデータ) {
  const スライド = プレゼン.appendSlide(SlidesApp.PredefinedLayout.BLANK);
  スライド.getBackground().setSolidFill(色設定.背景色);

  // ページヘッダー
  const コンテンツY = ページヘッダーを作成(スライド, 'PROJECT OVERVIEW', 'プロジェクト概要');

  // 2列レイアウト（左右）
  const 列幅 = (コンテンツ幅 - 15) / 2;
  const 左列X = 余白.左;
  const 右列X = 余白.左 + 列幅 + 15;
  const カード高さ = 105;

  // 左列上：目的
  _概要カード横を作成(スライド, 左列X, コンテンツY + 8, 列幅, カード高さ,
    'PURPOSE', '目的',
    '出版プロジェクトを成功させ、支えてくれた方やお世話になった方へ完成品を届ける');

  // 右列上：重要要素
  _概要カード横を作成(スライド, 右列X, コンテンツY + 8, 列幅, カード高さ,
    'KEY FACTORS', '重要要素',
    '・知人へのアプローチ戦略\n・お気に入り登録による事前興味喚起\n・支援者の8割は「身近な人」が基本モデル');

  // 左列下：成果物
  _概要カード横を作成(スライド, 左列X, コンテンツY + 123, 列幅, カード高さ,
    'DELIVERABLES', '成果物',
    '・90名を超える LINE登録者（支援見込み90%）\n・お気に入り登録者100名以上\n・支援者の8割は身近な人による支援モデル');

  // 右列下：資金の用途
  _概要カード横を作成(スライド, 右列X, コンテンツY + 123, 列幅, カード高さ,
    'USE OF FUNDS', '資金の用途',
    '自費出版(POD) 30冊');
}

function _概要カード横を作成(スライド, x, y, 幅, 高さ, 英字ラベル, 日本語ラベル, 内容) {
  // カード背景（角丸、白）
  図形を追加(スライド, '角丸長方形', {
    左位置: x, 上位置: y, 幅: 幅, 高さ: 高さ,
    塗りつぶし色: '#FFFFFF'
  });

  // 上ボーダー（オレンジ）
  図形を追加(スライド, '長方形', {
    左位置: x, 上位置: y, 幅: 幅, 高さ: 3,
    塗りつぶし色: 色設定.アクセント色
  });

  // アイコン（円）
  図形を追加(スライド, '楕円', {
    左位置: x + 10, 上位置: y + 12, 幅: 18, 高さ: 18,
    塗りつぶし色: 色設定.アクセント薄
  });

  // 英字ラベル
  テキストを追加(スライド, 英字ラベル, {
    左位置: x + 36, 上位置: y + 12, 幅: 幅 - 48, 高さ: 9,
    フォントサイズ: 7.5, 色: 色設定.テキスト薄
  });

  // 日本語ラベル
  テキストを追加(スライド, 日本語ラベル, {
    左位置: x + 36, 上位置: y + 20, 幅: 幅 - 48, 高さ: 12,
    フォントサイズ: 11, 太字: true, 色: 色設定.テキスト濃
  });

  // 内容テキスト
  テキストを追加(スライド, 内容, {
    左位置: x + 10, 上位置: y + 42, 幅: 幅 - 20, 高さ: 高さ - 50,
    フォントサイズ: 8.5, 色: 色設定.テキスト濃
  });
}

// ----------------------------------------
// P4: クラファン成功データ / KPI
// ----------------------------------------

function クラファン成功データスライドを作成(プレゼン) {
  const スライド = プレゼン.appendSlide(SlidesApp.PredefinedLayout.BLANK);
  スライド.getBackground().setSolidFill(色設定.背景色);

  // ページヘッダー
  const コンテンツY = ページヘッダーを作成(スライド, 'SUCCESS METRICS', 'クラファン成功データ', '重要KPI指標');

  // 3列レイアウト: 横並びで3つの大型KPIカード（安全な間隔）
  const カード間隔 = 12;
  const 列幅 = (コンテンツ幅 - カード間隔 * 2) / 3;
  const カード高さ = 145;

  // KPI 1: 支援者の80%は身近な人
  _KPI大カードを作成(スライド, 余白.左, コンテンツY + 8, 列幅, カード高さ,
    '支援者の構成比率', '8割',
    '支援者の約80%は友人・知人などの「身近な人」。全く知らない人からの支援は残りの2割程度です。');

  // KPI 2: 初動3日間が全てを決める
  _KPI大カードを作成(スライド, 余白.左 + 列幅 + カード間隔, コンテンツY + 8, 列幅, カード高さ,
    '初動の重要性', '3日間',
    '公開直後の「ゴールデンタイム」。この期間の盛り上がりが、その後のプロジェクトの成否を分けます。');

  // KPI 3: お気に入り→支援転換率
  _KPI大カードを作成(スライド, 余白.左 + (列幅 + カード間隔) * 2, コンテンツY + 8, 列幅, カード高さ,
    'お気に入り→支援転換率', '40%',
    '目標：お気に入り100件 ⇒ 支援40件');

  // 下段: 2列の小型KPIカード
  const 下段Y = コンテンツY + 8 + カード高さ + 8;
  const 半幅 = (コンテンツ幅 - カード間隔) / 2;
  const 下段高さ = 72;

  // 活動報告
  _KPI小カードを作成(スライド, 余白.左, 下段Y, 半幅, 下段高さ,
    '活動報告', '週3〜5本', '共感と再訪を促進');

  // 事前接触
  _KPI小カードを作成(スライド, 余白.左 + 半幅 + カード間隔, 下段Y, 半幅, 下段高さ,
    '事前接触', 'Min 3回', '公開前の告知回数');
}

function _KPI大カードを作成(スライド, x, y, 幅, 高さ, タイトル, 数字, 説明) {
  // カード背景（角丸）
  図形を追加(スライド, '角丸長方形', {
    左位置: x, 上位置: y, 幅: 幅, 高さ: 高さ,
    塗りつぶし色: 色設定.カード背景
  });

  // 上ボーダー（オレンジ）
  図形を追加(スライド, '長方形', {
    左位置: x, 上位置: y, 幅: 幅, 高さ: 3,
    塗りつぶし色: 色設定.アクセント色
  });

  // タイトル（小さく）
  テキストを追加(スライド, タイトル, {
    左位置: x + 10, 上位置: y + 8, 幅: 幅 - 20, 高さ: 14,
    フォントサイズ: 8, 太字: true, 色: 色設定.テキスト濃
  });

  // 超巨大な数字（メイン）
  テキストを追加(スライド, 数字, {
    左位置: x + 10, 上位置: y + 40, 幅: 幅 - 20, 高さ: 56,
    フォントサイズ: 56, 太字: true, 色: 色設定.アクセント色
  });

  // 説明（小さく、下部）
  テキストを追加(スライド, 説明, {
    左位置: x + 10, 上位置: y + 100, 幅: 幅 - 20, 高さ: 高さ - 106,
    フォントサイズ: 7.5, 色: 色設定.テキスト薄
  });
}

function _KPI小カードを作成(スライド, x, y, 幅, 高さ, タイトル, 数字, 説明) {
  // カード背景（角丸）
  図形を追加(スライド, '角丸長方形', {
    左位置: x, 上位置: y, 幅: 幅, 高さ: 高さ,
    塗りつぶし色: 色設定.カード背景
  });

  // 上ボーダー（オレンジ）
  図形を追加(スライド, '長方形', {
    左位置: x, 上位置: y, 幅: 幅, 高さ: 3,
    塗りつぶし色: 色設定.アクセント色
  });

  // タイトル
  テキストを追加(スライド, タイトル, {
    左位置: x + 10, 上位置: y + 8, 幅: 幅 - 20, 高さ: 12,
    フォントサイズ: 8, 太字: true, 色: 色設定.テキスト濃
  });

  // 数字（大きく）
  テキストを追加(スライド, 数字, {
    左位置: x + 10, 上位置: y + 24, 幅: 幅 - 20, 高さ: 30,
    フォントサイズ: 26, 太字: true, 色: 色設定.アクセント色
  });

  // 説明
  テキストを追加(スライド, 説明, {
    左位置: x + 10, 上位置: y + 56, 幅: 幅 - 20, 高さ: 12,
    フォントサイズ: 7.5, 色: 色設定.テキスト薄
  });
}

function _KPI縦カードを作成(スライド, y, タイトル, 数字, 説明) {
  // カード背景（角丸、白）
  図形を追加(スライド, '角丸長方形', {
    左位置: 余白.左, 上位置: y, 幅: コンテンツ幅, 高さ: 210,
    塗りつぶし色: '#FFFFFF'
  });

  // 上ボーダー（オレンジ）
  図形を追加(スライド, '長方形', {
    左位置: 余白.左, 上位置: y, 幅: コンテンツ幅, 高さ: 3,
    塗りつぶし色: 色設定.アクセント色
  });

  // アイコン（円）
  図形を追加(スライド, '楕円', {
    左位置: 余白.左 + 20, 上位置: y + 25, 幅: 32, 高さ: 32,
    塗りつぶし色: 色設定.アクセント薄
  });

  // タイトル
  テキストを追加(スライド, タイトル, {
    左位置: 余白.左 + 70, 上位置: y + 28, 幅: コンテンツ幅 - 100, 高さ: 26,
    フォントサイズ: フォントサイズ.見出し3, 太字: true, 色: 色設定.テキスト濃
  });

  // 大きな数字（中央）
  テキストを追加(スライド, 数字, {
    左位置: 余白.左, 上位置: y + 80, 幅: コンテンツ幅, 高さ: 60,
    フォントサイズ: 48, 太字: true, 色: 色設定.アクセント色, 配置: '中央'
  });

  // 説明
  テキストを追加(スライド, 説明, {
    左位置: 余白.左 + 30, 上位置: y + 155, 幅: コンテンツ幅 - 60, 高さ: 45,
    フォントサイズ: フォントサイズ.小, 色: 色設定.テキスト薄
  });
}

// ----------------------------------------
// P5: 目標金額の内訳
// ----------------------------------------

function 目標金額内訳スライドを作成(プレゼン, クライアントデータ) {
  const スライド = プレゼン.appendSlide(SlidesApp.PredefinedLayout.BLANK);
  スライド.getBackground().setSolidFill(色設定.背景色);

  // 右上装飾
  図形を追加(スライド, '楕円', {
    左位置: 750, 上位置: -60, 幅: 280, 高さ: 280,
    塗りつぶし色: 色設定.アクセント薄
  });

  const コンテンツY = ページヘッダーを作成(スライド, 'BUDGET BREAKDOWN', '目標金額の内訳');

  // 右上にTARGET金額表示
  テキストを追加(スライド, 'TARGET', {
    左位置: コンテンツ幅 + 余白.左 - 150, 上位置: 余白.上 - 5, 幅: 150, 高さ: 15,
    フォントサイズ: フォントサイズ.極小, 色: 色設定.テキスト薄, 配置: '右'
  });
  テキストを追加(スライド, `¥${クライアントデータ.目標金額.toLocaleString()}`, {
    左位置: コンテンツ幅 + 余白.左 - 150, 上位置: 余白.上 + 10, 幅: 150, 高さ: 25,
    フォントサイズ: フォントサイズ.見出し2, 太字: true, 色: 色設定.アクセント色, 配置: '右'
  });

  // 2列レイアウト: 左=円グラフ代替、右=内訳リスト
  const 左列X = 余白.左;
  const 右列X = 余白.左 + 350;
  const 右列幅 = コンテンツ幅 - 350;

  // 左列: 円グラフ風の表示（大きな円 + 中央テキスト）
  const 円X = 左列X + 60;
  const 円Y = コンテンツY + 20;
  const 円サイズ = 220;

  図形を追加(スライド, '楕円', {
    左位置: 円X, 上位置: 円Y, 幅: 円サイズ, 高さ: 円サイズ,
    塗りつぶし色: 色設定.アクセント色
  });

  // 内側の白い円（ドーナツ効果）
  const 内円サイズ = 140;
  const 内円オフセット = (円サイズ - 内円サイズ) / 2;
  図形を追加(スライド, '楕円', {
    左位置: 円X + 内円オフセット, 上位置: 円Y + 内円オフセット, 幅: 内円サイズ, 高さ: 内円サイズ,
    塗りつぶし色: 色設定.背景色
  });

  // 中央テキスト
  テキストを追加(スライド, 'TOTAL', {
    左位置: 円X + 内円オフセット, 上位置: 円Y + 内円オフセット + 35, 幅: 内円サイズ, 高さ: 18,
    フォントサイズ: フォントサイズ.極小, 色: 色設定.テキスト薄, 配置: '中央'
  });

  const 目標金額万 = Math.round(クライアントデータ.目標金額 / 10000);
  テキストを追加(スライド, `${目標金額万}万`, {
    左位置: 円X + 内円オフセット, 上位置: 円Y + 内円オフセット + 52, 幅: 内円サイズ, 高さ: 35,
    フォントサイズ: 28, 太字: true, 色: 色設定.アクセント色, 配置: '中央'
  });

  // 右列: 内訳リスト
  const 内訳リスト = [
    { 項目: '編集・デザイン', 金額: '10万円' },
    { 項目: '印刷・製本（100〜150部）', 金額: '15〜20万円' },
    { 項目: '手数料（約17%想定）', 金額: '7〜8万円' },
    { 項目: '梱包・発送・資材', 金額: '5〜8万円' },
    { 項目: '広報・イベント・予備費', 金額: '5〜8万円' }
  ];

  let 内訳Y = コンテンツY + 20;
  const 行高さ = 44;

  内訳リスト.forEach(項目 => {
    // 行カード
    図形を追加(スライド, '長方形', {
      左位置: 右列X, 上位置: 内訳Y, 幅: 右列幅, 高さ: 行高さ - 5,
      塗りつぶし色: 色設定.カード背景
    });

    // 左ボーダー
    図形を追加(スライド, '長方形', {
      左位置: 右列X, 上位置: 内訳Y, 幅: 4, 高さ: 行高さ - 5,
      塗りつぶし色: 色設定.アクセント色
    });

    テキストを追加(スライド, 項目.項目, {
      左位置: 右列X + 15, 上位置: 内訳Y + 10, 幅: 右列幅 - 130, 高さ: 20,
      フォントサイズ: フォントサイズ.本文, 太字: true, 色: 色設定.テキスト濃
    });

    テキストを追加(スライド, 項目.金額, {
      左位置: 右列X + 右列幅 - 110, 上位置: 内訳Y + 10, 幅: 100, 高さ: 20,
      フォントサイズ: フォントサイズ.見出し3, 太字: true, 色: 色設定.アクセント色, 配置: '右'
    });

    内訳Y += 行高さ;
  });

  // 注記
  テキストを追加(スライド, '※金額は概算であり、内容等で変動します。', {
    左位置: 右列X, 上位置: 内訳Y + 5, 幅: 右列幅, 高さ: 16,
    フォントサイズ: フォントサイズ.極小, 色: 色設定.テキスト薄, 配置: '右'
  });

  // 下部: 目標金額バー（ダーク背景）
  const バーY = ページサイズ.高さ - 余白.下 - 50;
  図形を追加(スライド, '角丸長方形', {
    左位置: 余白.左, 上位置: バーY, 幅: コンテンツ幅, 高さ: 48,
    塗りつぶし色: 色設定.暗い背景
  });

  テキストを追加(スライド, 'クラウドファンディング目標金額', {
    左位置: 余白.左, 上位置: バーY + 5, 幅: コンテンツ幅, 高さ: 16,
    フォントサイズ: フォントサイズ.極小, 色: '#AAAAAA', 配置: '中央'
  });

  テキストを追加(スライド, `${クライアントデータ.目標金額.toLocaleString()}円`, {
    左位置: 余白.左, 上位置: バーY + 20, 幅: コンテンツ幅, 高さ: 25,
    フォントサイズ: フォントサイズ.見出し2, 太字: true, 色: '#FFFFFF', 配置: '中央'
  });
}

// ----------------------------------------
// P6: 支援者見込み / 目標シナリオ
// ----------------------------------------

function 支援者見込みスライドを作成(プレゼン, クライアントデータ) {
  const スライド = プレゼン.appendSlide(SlidesApp.PredefinedLayout.BLANK);
  スライド.getBackground().setSolidFill(色設定.背景色);

  // 右上装飾
  図形を追加(スライド, '楕円', {
    左位置: 750, 上位置: -60, 幅: 280, 高さ: 280,
    塗りつぶし色: 色設定.アクセント薄
  });

  const コンテンツY = ページヘッダーを作成(スライド, 'TARGET SCENARIO', '支援者見込み');

  // 右上にGOAL表示
  const 目標金額万 = Math.round(クライアントデータ.目標金額 / 10000);
  テキストを追加(スライド, 'GOAL', {
    左位置: コンテンツ幅 + 余白.左 - 120, 上位置: 余白.上 - 5, 幅: 120, 高さ: 15,
    フォントサイズ: フォントサイズ.極小, 色: 色設定.テキスト薄, 配置: '右'
  });
  テキストを追加(スライド, `${目標金額万}万円`, {
    左位置: コンテンツ幅 + 余白.左 - 120, 上位置: 余白.上 + 10, 幅: 120, 高さ: 28,
    フォントサイズ: フォントサイズ.見出し1, 太字: true, 色: 色設定.アクセント色, 配置: '右'
  });

  // 3ステップカード
  let y = コンテンツY + 10;
  const ステップ高さ = 110;
  const ステップ間隔 = 10;

  // STEP 1
  _ステップカードを作成(スライド, y, 'STEP 1：基盤を作る', 'お気に入り登録からの転換', '20万円',
    'お気に入り100件 × 転換率40% = 40人',
    '身近な友人・家族・コアなフォロワー', '平均単価 ¥5,000 × 40人');
  y += ステップ高さ + ステップ間隔;

  // プラスアイコン
  テキストを追加(スライド, '+', {
    左位置: (ページサイズ.幅 - 20) / 2, 上位置: y - 8, 幅: 20, 高さ: 16,
    フォントサイズ: フォントサイズ.本文, 太字: true, 色: 色設定.アクセント色, 配置: '中央'
  });

  // STEP 2
  _ステップカードを作成(スライド, y, 'STEP 2：層を広げる', '中価格帯リターンの拡充', '+ 20万円',
    '追加支援者 40人獲得',
    '友人の友人・共感した新規層', '平均単価 ¥5,000 × 40人');
  y += ステップ高さ + ステップ間隔;

  // プラスアイコン
  テキストを追加(スライド, '+', {
    左位置: (ページサイズ.幅 - 20) / 2, 上位置: y - 8, 幅: 20, 高さ: 16,
    フォントサイズ: フォントサイズ.本文, 太字: true, 色: 色設定.アクセント色, 配置: '中央'
  });

  // STEP 3
  _ステップカードを作成(スライド, y, 'STEP 3：押し上げ', '高額リターンでのブースト', '+ 10万円',
    '特別な支援 5〜10件',
    '深く共感した方・スポンサー・団体', '例: ¥20,000 × 5件など');
}

function _ステップカードを作成(スライド, y, ステップラベル, タイトル, 金額, 説明1, ターゲット, 単価説明) {
  // カード全体
  図形を追加(スライド, '長方形', {
    左位置: 余白.左, 上位置: y, 幅: コンテンツ幅, 高さ: 110,
    塗りつぶし色: 色設定.カード背景
  });

  // 上ボーダー
  図形を追加(スライド, '長方形', {
    左位置: 余白.左, 上位置: y, 幅: コンテンツ幅, 高さ: 4,
    塗りつぶし色: 色設定.アクセント色
  });

  // ステップラベル（角丸バッジ）
  ラベルを作成(スライド, 余白.左 + 15, y + 10, ステップラベル, {
    幅: ステップラベル.length * 8 + 20, 高さ: 20,
    背景色: 色設定.暗い背景, フォントサイズ: フォントサイズ.極小
  });

  // タイトル
  テキストを追加(スライド, タイトル, {
    左位置: 余白.左 + 15, 上位置: y + 36, 幅: コンテンツ幅 - 160, 高さ: 22,
    フォントサイズ: フォントサイズ.見出し3, 太字: true, 色: 色設定.テキスト濃
  });

  // 金額（右寄せ）
  テキストを追加(スライド, 金額, {
    左位置: コンテンツ幅 + 余白.左 - 130, 上位置: y + 36, 幅: 120, 高さ: 22,
    フォントサイズ: フォントサイズ.見出し3, 太字: true, 色: 色設定.アクセント色, 配置: '右'
  });

  // 説明1
  テキストを追加(スライド, 説明1, {
    左位置: 余白.左 + 15, 上位置: y + 60, 幅: コンテンツ幅 - 30, 高さ: 16,
    フォントサイズ: フォントサイズ.小, 色: 色設定.テキスト薄
  });

  // ターゲット + 単価
  テキストを追加(スライド, `TARGET: ${ターゲット}`, {
    左位置: 余白.左 + 15, 上位置: y + 80, 幅: コンテンツ幅 * 0.55, 高さ: 16,
    フォントサイズ: フォントサイズ.極小, 色: 色設定.テキスト薄
  });

  テキストを追加(スライド, 単価説明, {
    左位置: コンテンツ幅 + 余白.左 - 200, 上位置: y + 80, 幅: 190, 高さ: 16,
    フォントサイズ: フォントサイズ.極小, 色: 色設定.テキスト薄, 配置: '右'
  });
}
