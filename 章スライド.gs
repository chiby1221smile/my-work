    フォントサイズ: フォントサイズ.見出し1, 太字: true, 色: '#FFFFFF'
  });
  y += 78;

  const 次の一手 = [
    { 番号: '1', タイトル: '連絡先リスト100名を作る', 説明: '紙orスプレッドシートにリスト化。優先度A・B・Cに分けて整理。' },
    { 番号: '2', タイトル: 'お気に入り登録100件を目指す', 説明: '公開前日までにSNS・個別連絡でお気に入り登録を依頼。' },
    { 番号: '3', タイトル: '公開告知の準備', 説明: 'SNS投稿文・個別メッセージテンプレートを用意。' },
    { 番号: '4', タイトル: '活動報告のネタを用意', 説明: 'プロジェクトへの想い・制作過程の写真など、発信ネタを準備。' },
    { 番号: '5', タイトル: 'このマーケティング資料を見返す', 説明: '公開前・公開中・ラスト3日間で何度も読み返し、戦略を実行。' }
  ];

  次の一手.forEach(項目 => {
    ステップカードを作成(スライド, 余白.左, y, 項目.番号, 項目.タイトル, 項目.説明,
      { 高さ: 75 });
    y += 82;
  });
}

function 最終スライドを作成(プレゼン) {
  const スライド = プレゼン.appendSlide(SlidesApp.PredefinedLayout.BLANK);
  スライド.getBackground().setSolidFill(色設定.アクセント色);

  // 中央に大きなメッセージ
  テキストを追加(スライド, 'あなたのプロジェクトの成功を\n心から応援しています！', {
    左位置: 余白.左, 上位置: 180, 幅: コンテンツ幅, 高さ: 80,
    フォントサイズ: フォントサイズ.見出し1, 太字: true, 色: '#FFFFFF', 配置: '中央'
  });

  テキストを追加(スライド, 'がんばってください！', {
    左位置: 余白.左, 上位置: 270, 幅: コンテンツ幅, 高さ: 50,
    フォントサイズ: フォントサイズ.見出し2, 太字: true, 色: '#FFFFFF', 配置: '中央'
  });

  図形を追加(スライド, '長方形', {
    左位置: 380, 上位置: 330, 幅: 200, 高さ: 4,
    塗りつぶし色: '#FFFFFF'
  });

  テキストを追加(スライド, 'CAMPFIRE マーケティング戦略資料', {
    左位置: 余白.左, 上位置: 380, 幅: コンテンツ幅, 高さ: 30,
    フォントサイズ: フォントサイズ.本文, 色: '#FFFFFF', 配置: '中央'
  });

  テキストを追加(スライド, '作成日: 2026年1月', {
    左位置: 余白.左, 上位置: 415, 幅: コンテンツ幅, 高さ: 20,
    フォントサイズ: フォントサイズ.極小, 色: '#FFFFFF', 配置: '中央'
  });
}
