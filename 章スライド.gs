// ========================================
// 第2章：全体スケジュール（P7-P11）
// ========================================

function 第2章を作成(プレゼン, クライアントデータ) {
  章タイトルスライドを作成(プレゼン, '02', '全体スケジュール', '31日間の戦略ロードマップ');
  全体スケジュール概要スライドを作成(プレゼン);
  スタートダッシュフェーズスライドを作成(プレゼン);
  週1_2フェーズスライドを作成(プレゼン);
  中盤対策スライドを作成(プレゼン);
  ラスト72時間スライドを作成(プレゼン);
}

// ----------------------------------------
// P7: 全体スケジュール概要（2月カレンダー形式）
// ----------------------------------------

function 全体スケジュール概要スライドを作成(プレゼン) {
  const スライド = プレゼン.appendSlide(SlidesApp.PredefinedLayout.BLANK);
  スライド.getBackground().setSolidFill(色設定.背景色);

  // 右上装飾（スライド幅内に収める: 700 + 260 = 960）
  図形を追加(スライド, '楕円', {
    左位置: 700, 上位置: -60, 幅: 260, 高さ: 260,
    塗りつぶし色: 色設定.アクセント薄
  });

  const コンテンツY = ページヘッダーを作成(スライド, 'PROJECT TIMELINE', '全体スケジュール', '2026年3月（31日間）');

  // 4つのフェーズカード（横並び）
  const カード幅 = 190;  // (840 - 45) / 4 = 198.75, use 190 for safety (50pt buffer)
  const カード間隔 = 15;
  const カード高さ = 100;
  let x = 余白.左;
  const y = コンテンツY + 15;

  const フェーズ一覧 = [
    { ラベル: 'PHASE 1', タイトル: 'スタート\nダッシュ', 期間: '1〜3日目', 色: 色設定.アクセント色 },
    { ラベル: 'PHASE 2', タイトル: '基盤\n構築', 期間: '4〜14日目', 色: '#FF9500' },
    { ラベル: 'PHASE 3', タイトル: '中盤\n拡散', 期間: '15〜28日目', 色: '#FF9500' },
    { ラベル: 'PHASE 4', タイトル: 'ラスト\n72時間', 期間: '29〜31日目', 色: 色設定.赤 }
  ];

  フェーズ一覧.forEach((フェーズ, idx) => {
    図形を追加(スライド, '長方形', {
      左位置: x, 上位置: y, 幅: カード幅, 高さ: カード高さ,
      塗りつぶし色: 色設定.カード背景
    });

    図形を追加(スライド, '長方形', {
      左位置: x, 上位置: y, 幅: カード幅, 高さ: 4,
      塗りつぶし色: フェーズ.色
    });

    ラベルを作成(スライド, x + 10, y + 10, フェーズ.ラベル, {
      幅: 70, 高さ: 18, 背景色: フェーズ.色, フォントサイズ: フォントサイズ.極小
    });

    テキストを追加(スライド, フェーズ.タイトル, {
      左位置: x + 10, 上位置: y + 36, 幅: カード幅 - 20, 高さ: 40,
      フォントサイズ: フォントサイズ.見出し3, 太字: true, 色: 色設定.テキスト濃
    });

    テキストを追加(スライド, フェーズ.期間, {
      左位置: x + 10, 上位置: y + 75, 幅: カード幅 - 20, 高さ: 18,
      フォントサイズ: フォントサイズ.極小, 色: 色設定.テキスト薄
    });

    x += カード幅 + カード間隔;
  });

  // タイムライン形式の詳細スケジュール
  let タイムラインY = y + カード高さ + 25;

  const スケジュール項目 = [
    { 日付: 'Day 0', ラベル: '公開前日', アクション: '最終確認・お気に入り登録呼びかけ・公開予告投稿' },
    { 日付: 'Day 1', ラベル: '【超重要】初日', アクション: '一斉告知・個別連絡100名・SNS同時投稿・リアルタイム進捗共有' },
    { 日付: 'Day 2-3', ラベル: '初動継続', アクション: 'お礼投稿・追加連絡・未達成なら緊急対策会議' },
    { 日付: 'Day 4-14', ラベル: '基盤構築期', アクション: '活動報告2〜3本/週・交流会準備・リターン見直し検討' },
    { 日付: 'Day 15-28', ラベル: '中盤拡散期', アクション: 'SNS拡散強化・コラボ施策・新規層へのアプローチ' },
    { 日付: 'Day 29-31', ラベル: 'ラスト72h', アクション: '毎日投稿・カウントダウン・達成間近アピール・感謝メッセージ' }
  ];

  スケジュール項目.forEach((項目, idx) => {
    図形を追加(スライド, '楕円', {
      左位置: 余白.左, 上位置: タイムラインY + 5, 幅: 14, 高さ: 14,
      塗りつぶし色: idx === 1 ? 色設定.赤 : 色設定.アクセント色
    });

    ラベルを作成(スライド, 余白.左 + 25, タイムラインY, 項目.日付, {
      幅: 80, 高さ: 20, 背景色: idx === 1 ? 色設定.赤 : 色設定.暗い背景,
      フォントサイズ: フォントサイズ.極小
    });

    図形を追加(スライド, '長方形', {
      左位置: 余白.左 + 115, 上位置: タイムラインY - 2, 幅: コンテンツ幅 - 115, 高さ: 48,
      塗りつぶし色: 色設定.カード背景
    });

    図形を追加(スライド, '長方形', {
      左位置: 余白.左 + 115, 上位置: タイムラインY - 2, 幅: 4, 高さ: 48,
      塗りつぶし色: idx === 1 ? 色設定.赤 : 色設定.アクセント色
    });

    テキストを追加(スライド, 項目.ラベル, {
      左位置: 余白.左 + 130, 上位置: タイムラインY + 3, 幅: 150, 高さ: 18,
      フォントサイズ: フォントサイズ.見出し3, 太字: true, 色: 色設定.テキスト濃
    });

    テキストを追加(スライド, 項目.アクション, {
      左位置: 余白.左 + 130, 上位置: タイムラインY + 22, 幅: コンテンツ幅 - 145, 高さ: 20,
      フォントサイズ: フォントサイズ.極小, 色: 色設定.テキスト薄
    });

    タイムラインY += 54;
  });
}

// ----------------------------------------
// P8: スタートダッシュフェーズ（初日〜3日目）
// ----------------------------------------

function スタートダッシュフェーズスライドを作成(プレゼン) {
  const スライド = プレゼン.appendSlide(SlidesApp.PredefinedLayout.BLANK);
  スライド.getBackground().setSolidFill(色設定.背景色);

  // 右上装飾（スライド幅内に収める: 700 + 260 = 960）
  図形を追加(スライド, '楕円', {
    左位置: 700, 上位置: -60, 幅: 260, 高さ: 260,
    塗りつぶし色: 色設定.アクセント薄
  });

  const コンテンツY = ページヘッダーを作成(スライド, 'PHASE 1: START DASH', 'スタートダッシュフェーズ', '初日〜3日目の行動計画');

  // 目標KPIカード（上部）
  図形を追加(スライド, '角丸長方形', {
    左位置: 余白.左, 上位置: コンテンツY + 10, 幅: コンテンツ幅, 高さ: 60,
    塗りつぶし色: 色設定.暗い背景
  });

  テキストを追加(スライド, '🎯 目標KPI', {
    左位置: 余白.左 + 20, 上位置: コンテンツY + 18, 幅: 200, 高さ: 20,
    フォントサイズ: フォントサイズ.見出し3, 太字: true, 色: '#FFFFFF'
  });

  テキストを追加(スライド, '3日間で30%達成 ＝ 成功率90%超え', {
    左位置: 余白.左 + 20, 上位置: コンテンツY + 38, 幅: コンテンツ幅 - 40, 高さ: 24,
    フォントサイズ: フォントサイズ.見出し2, 太字: true, 色: 色設定.アクセント色
  });

  // 3日間の詳細スケジュール（3列レイアウト）
  const 列幅 = 250;  // (840 - 40) / 3 = 266.67, use 250 for safety (40pt buffer)
  let x = 余白.左;
  const カードY = コンテンツY + 85;

  const 日別計画 = [
    {
      日: 'Day 1',
      ラベル: '初日',
      重要度: '超重要',
      タスク: [
        '✓ 0時公開・一斉告知',
        '✓ 個別連絡100名実施',
        '✓ SNS同時投稿',
        '✓ 進捗リアルタイム共有',
        '✓ お礼投稿（随時）'
      ]
    },
    {
      日: 'Day 2',
      ラベル: '2日目',
      重要度: '重要',
      タスク: [
        '✓ 初日お礼投稿',
        '✓ 追加個別連絡',
        '✓ 活動報告1本目',
        '✓ 進捗状況シェア',
        '✓ 未支援者フォロー'
      ]
    },
    {
      日: 'Day 3',
      ラベル: '3日目',
      重要度: '重要',
      タスク: [
        '✓ 3日間の振り返り',
        '✓ 30%達成確認',
        '✓ 感謝メッセージ',
        '✓ 次フェーズ準備',
        '✓ 未達なら緊急対策'
      ]
    }
  ];

  日別計画.forEach(日 => {
    図形を追加(スライド, '長方形', {
      左位置: x, 上位置: カードY, 幅: 列幅, 高さ: 270,
      塗りつぶし色: 色設定.カード背景
    });

    図形を追加(スライド, '長方形', {
      左位置: x, 上位置: カードY, 幅: 列幅, 高さ: 5,
      塗りつぶし色: 日.日 === 'Day 1' ? 色設定.赤 : 色設定.アクセント色
    });

    ラベルを作成(スライド, x + 10, カードY + 15, 日.日, {
      幅: 60, 高さ: 22, 背景色: 日.日 === 'Day 1' ? 色設定.赤 : 色設定.アクセント色,
      フォントサイズ: フォントサイズ.小
    });

    テキストを追加(スライド, 日.ラベル, {
      左位置: x + 80, 上位置: カードY + 17, 幅: 列幅 - 90, 高さ: 20,
      フォントサイズ: フォントサイズ.見出し3, 太字: true, 色: 色設定.テキスト濃
    });

    if (日.重要度) {
      ラベルを作成(スライド, x + 10, カードY + 45, 日.重要度, {
        幅: 列幅 - 20, 高さ: 20, 背景色: 日.日 === 'Day 1' ? 色設定.赤 : 色設定.アクセント薄,
        文字色: 日.日 === 'Day 1' ? '#FFFFFF' : 色設定.赤, フォントサイズ: フォントサイズ.極小
      });
    }

    let タスクY = カードY + 75;
    日.タスク.forEach(タスク => {
      テキストを追加(スライド, タスク, {
        左位置: x + 12, 上位置: タスクY, 幅: 列幅 - 24, 高さ: 16,
        フォントサイズ: フォントサイズ.極小, 色: 色設定.テキスト濃
      });
      タスクY += 24;
    });

    x += 列幅 + 20;
  });

  // 下部注意事項
  図形を追加(スライド, '角丸長方形', {
    左位置: 余白.左, 上位置: カードY + 285, 幅: コンテンツ幅, 高さ: 50,
    塗りつぶし色: '#FFF3E0'
  });

  テキストを追加(スライド, '⚠️ 重要ポイント', {
    左位置: 余白.左 + 15, 上位置: カードY + 292, 幅: 150, 高さ: 18,
    フォントサイズ: フォントサイズ.小, 太字: true, 色: 色設定.赤
  });

  テキストを追加(スライド, '初日15%、3日間30%達成が最優先。この数字が成功の分かれ目です。身近な人への個別連絡は丁寧に！', {
    左位置: 余白.左 + 15, 上位置: カードY + 310, 幅: コンテンツ幅 - 30, 高さ: 22,
    フォントサイズ: フォントサイズ.小, 色: 色設定.テキスト濃
  });
}

// ----------------------------------------
// P9: 1-2週目フェーズ
// ----------------------------------------

function 週1_2フェーズスライドを作成(プレゼン) {
  const スライド = プレゼン.appendSlide(SlidesApp.PredefinedLayout.BLANK);
  スライド.getBackground().setSolidFill(色設定.背景色);

  // 右上装飾（スライド幅内に収める: 700 + 260 = 960）
  図形を追加(スライド, '楕円', {
    左位置: 700, 上位置: -60, 幅: 260, 高さ: 260,
    塗りつぶし色: 色設定.アクセント薄
  });

  const コンテンツY = ページヘッダーを作成(スライド, 'PHASE 2: FOUNDATION', '基盤構築フェーズ', '4日目〜14日目の戦略');

  // 2列レイアウト
  const 列幅 = 380;  // (840 - 30) / 2 = 405, use 380 for safety (50pt buffer)

  // 左列: やること
  let y = コンテンツY + 10;

  情報カードを作成(スライド, 余白.左, y, 列幅, 80, '📌 このフェーズの目標',
    '・初動の勢いを維持\n・活動報告で共感を醸成\n・新規支援者の獲得準備',
    { 左ボーダー: true, タイトルサイズ: フォントサイズ.見出し3 });

  y += 88;

  const 左列タスク = [
    { タイトル: '活動報告を週2〜3本投稿', 内容: 'プロジェクトの進捗・想い・裏話などを発信。支援者との絆を深める。' },
    { タイトル: 'SNS発信の継続', 内容: 'X（Twitter）・Note・Amebaなどで定期投稿。プロジェクトを忘れさせない。' },
    { タイトル: '交流会・イベントの企画', 内容: 'オンライン説明会や交流イベントの準備。新規層へのアプローチを計画。' },
    { タイトル: 'お礼メッセージの送付', 内容: '支援者一人ひとりに感謝を伝える。次の応援（シェア・拡散）につながる。' }
  ];

  左列タスク.forEach(タスク => {
    情報カードを作成(スライド, 余白.左, y, 列幅, 75, タスク.タイトル, タスク.内容,
      { 左ボーダー: true, タイトルサイズ: フォントサイズ.本文, 内容サイズ: フォントサイズ.極小 });
    y += 82;
  });

  // 右列: やらないこと・注意点
  y = コンテンツY + 10;

  情報カードを作成(スライド, 余白.左 + 列幅 + 30, y, 列幅, 80, '⚠️ 注意すべきこと',
    '・投稿頻度を落としすぎない\n・単なる宣伝にならないよう注意\n・支援者への感謝を忘れない',
    { 左ボーダー: true, ボーダー色: 色設定.赤, タイトル色: 色設定.赤, タイトルサイズ: フォントサイズ.見出し3 });

  y += 88;

  const 右列項目 = [
    { タイトル: '❌ やってはいけないこと', 内容: '・コピペ一括送信\n・宣伝ばかりの投稿\n・支援者への無反応\n・ネガティブ発言' },
    { タイトル: '✅ この期間にやるべきこと', 内容: '・リターン内容の見直し\n・支援が伸び悩んでいる場合の原因分析\n・新しいアプローチ方法の検討' },
    { タイトル: '📊 進捗チェック', 内容: '1週目終了時点で50%達成が理想。未達なら追加施策を即実行。2週目で70%を目指す。' }
  ];

  右列項目.forEach(項目 => {
    情報カードを作成(スライド, 余白.左 + 列幅 + 30, y, 列幅, 95, 項目.タイトル, 項目.内容,
      { 左ボーダー: true, タイトルサイズ: フォントサイズ.本文, 内容サイズ: フォントサイズ.極小 });
    y += 102;
  });
}

// ----------------------------------------
// P10: 中盤対策（拡散・獲得）
// ----------------------------------------

function 中盤対策スライドを作成(プレゼン) {
  const スライド = プレゼン.appendSlide(SlidesApp.PredefinedLayout.BLANK);
  スライド.getBackground().setSolidFill(色設定.背景色);

  // 右上装飾（スライド幅内に収める: 700 + 260 = 960）
  図形を追加(スライド, '楕円', {
    左位置: 700, 上位置: -60, 幅: 260, 高さ: 260,
    塗りつぶし色: 色設定.アクセント薄
  });

  const コンテンツY = ページヘッダーを作成(スライド, 'PHASE 3: EXPANSION', '中盤拡散フェーズ', '15日目〜28日目の戦略');

  // 上部: 目標カード
  図形を追加(スライド, '角丸長方形', {
    左位置: 余白.左, 上位置: コンテンツY + 10, 幅: コンテンツ幅, 高さ: 55,
    塗りつぶし色: 色設定.暗い背景
  });

  テキストを追加(スライド, '🎯 このフェーズの目標', {
    左位置: 余白.左 + 20, 上位置: コンテンツY + 18, 幅: 200, 高さ: 18,
    フォントサイズ: フォントサイズ.見出し3, 太字: true, 色: '#FFFFFF'
  });

  テキストを追加(スライド, '新規層への拡散を強化し、80〜100%達成を目指す', {
    左位置: 余白.左 + 20, 上位置: コンテンツY + 36, 幅: コンテンツ幅 - 40, 高さ: 22,
    フォントサイズ: フォントサイズ.見出し3, 太字: true, 色: 色設定.アクセント色
  });

  // 3つの戦略カード
  let y = コンテンツY + 80;
  const 戦略高さ = 100;

  ステップカードを作成(スライド, 余白.左, y, '1', 'SNS拡散の強化',
    'ハッシュタグ活用・他のプロジェクトとのコラボ・インフルエンサーへの協力依頼など、新しい層にリーチする施策を実行。',
    { 高さ: 戦略高さ });
  y += 戦略高さ + 8;

  ステップカードを作成(スライド, 余白.左, y, '2', 'メディア露出・プレスリリース',
    '地域メディアやオンラインメディアへのアプローチ。プレスリリース配信で認知度アップを狙う。',
    { 高さ: 戦略高さ });
  y += 戦略高さ + 8;

  ステップカードを作成(スライド, 余白.左, y, '3', '活動報告・ストーリー発信',
    '週2〜3本ペースで活動報告を継続。プロジェクトへの想いやエピソードを丁寧に伝え、共感を広げる。',
    { 高さ: 戦略高さ });
  y += 戦略高さ + 8;

  // 下部注意
  図形を追加(スライド, '角丸長方形', {
    左位置: 余白.左, 上位置: y, 幅: コンテンツ幅, 高さ: 45,
    塗りつぶし色: '#FFF3E0'
  });

  テキストを追加(スライド, '💡 ポイント：中だるみ注意！活動報告と新しい施策で熱量を保ちましょう。', {
    左位置: 余白.左 + 15, 上位置: y + 13, 幅: コンテンツ幅 - 30, 高さ: 20,
    フォントサイズ: フォントサイズ.小, 太字: true, 色: 色設定.テキスト濃
  });
}

// ----------------------------------------
// P11: ラスト72時間（最終追い込み）
